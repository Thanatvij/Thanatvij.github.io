---
/** The four inline icons the design uses. Decorative: always hidden from assistive tech. */
interface Props { name: 'arrow-ur' | 'arrow-r' | 'sun' | 'moon'; class?: string }
const { name, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  'arrow-ur': '<path d="M7 17 17 7M8 7h9v9"/>',
  'arrow-r': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z"/>',
};
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={paths[name]} />
