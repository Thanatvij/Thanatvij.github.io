---
/** Tinted closing band: heading on the left, lead + one button on the right. */
import Icon from './Icon.astro';
interface Props { id: string; eyebrow: string; titleStart: string; titleEmphasis: string; lead: string; cta: { label: string; href: string } }
const { id, eyebrow, titleStart, titleEmphasis, lead, cta } = Astro.props;
---
<section class="section section--tint" aria-labelledby={id}>
  <div class="wrap section-head">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="h2" id={id}>{titleStart} <em>{titleEmphasis}</em></h2>
    </div>
    <div>
      <p class="lead">{lead}</p>
      <p class="mt-2"><a class="btn btn--primary" href={cta.href}>{cta.label} <Icon name="arrow-ur" /></a></p>
    </div>
  </div>
</section>
