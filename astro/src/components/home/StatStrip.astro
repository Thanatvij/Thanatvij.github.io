---
import type { CollectionEntry } from 'astro:content';
interface Props { data: CollectionEntry<'home'>['data']['stats'] }
const { data } = Astro.props;
---
<section class="strip" aria-label={data.ariaLabel}>
  <div class="wrap strip-grid">
    {data.items.map((i) => <div class="strip-item"><strong>{i.value}</strong><span>{i.label}</span></div>)}
  </div>
</section>
