---
import type { CollectionEntry } from 'astro:content';
import ArrowLink from '../ArrowLink.astro';

interface Props { data: CollectionEntry<'home'>['data']['flagship'] }
const { data: f } = Astro.props;
---
<article class="flagship" aria-labelledby="flagship-title">
  <a class="flagship-media" href={f.link.href} tabindex="-1" aria-hidden="true">
    <img data-parallax="0.06" data-parallax-max="12" src={f.image.src} alt={f.image.alt} width={f.image.width} height={f.image.height} fetchpriority="high" />
    <span class="flag flagship-badge">{f.badge}</span>
    <span class="reticle"><i></i><i></i><i></i><i></i></span>
  </a>
  <div class="flagship-body">
    <p class="label">{f.meta}</p>
    <h2 id="flagship-title">{f.title}</h2>
    <p>{f.description}</p>
    <dl class="stat-row">
      {f.stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
    <ArrowLink label={f.link.label} href={f.link.href} />
  </div>
</article>
