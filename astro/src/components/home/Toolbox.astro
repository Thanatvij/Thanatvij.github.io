---
import type { CollectionEntry } from 'astro:content';
import SectionHead from '../SectionHead.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props { data: CollectionEntry<'home'>['data']['toolbox'] }
const { data } = Astro.props;
---
<section class="section section--tint" id="toolbox" aria-labelledby="toolbox-title">
  <div class="wrap">
    <SectionHead id="toolbox-title" eyebrow={data.eyebrow} titleStart={data.titleStart} titleEmphasis={data.titleEmphasis} lead={data.lead} />
    <dl class="toolbox reveal">
      {data.groups.map((g) => <div><dt>{g.name}</dt><dd>{g.items.map((i) => <span>{i}</span>)}</dd></div>)}
    </dl>
    <p class="more"><ArrowLink label={data.more.label} href={data.more.href} /></p>
  </div>
</section>
